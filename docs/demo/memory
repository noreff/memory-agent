#!/usr/bin/env bash
# Tiny staged demo CLI for the README hero GIF. Numbers are illustrative; the recall
# answer is pulled from the sanitized note in ./kb so it isn't fabricated.
cd "$(dirname "$0")"
b(){ printf '\033[1m%s\033[0m\n' "$1"; }   # bold (terminal foreground is green via the tape theme)
d(){ printf '\033[2m%s\033[0m\n' "$1"; }   # dim
case "$1" in
  index)
    echo "indexing your history…"; sleep .5
    d "  ~/.claude/projects         103 sessions"; sleep .45
    d "  chatgpt-export.json      3,781 conversations"; sleep .55
    echo "  extracting atoms · local model (qwen3, on-device, \$0)"; sleep .9
    echo "  routing + merging into notes · sonnet"; sleep .8
    b "  6,419 atoms  →  41 canonical notes"; sleep .4
    echo "done in 47s. your memory is 41 markdown files you own."
    ;;
  recall)
    echo; echo "do you recall: $2"; sleep .9; echo
    b "  caching-layer.md · 3 sources · updated 2026-05-28"
    echo "  Dragonfly on localhost:6380  (docker compose up cache)"
    echo "  CACHE_URL in .env  →  config/cache.py"
    echo
    printf '\033[1;33m  ⚠ conflict:\033[0m was Redis :6379 until the 2026-05 migration —\n'
    echo "     superseded by recency, kept in the note, not overwritten"
    ;;
esac
